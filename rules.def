Bootstrap: docker
From: nvidia/cuda:11.7.1-cudnn8-devel-ubuntu20.04

%environment
    export PATH=/opt/conda/bin:$PATH
    export CUDA_HOME=/usr/local/cuda
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
    export CONDA_PREFIX=/opt/conda
    export CONDA_DEFAULT_ENV=syncmvd
    export PYTHONPATH=/opt/conda/envs/syncmvd/lib/python3.8/site-packages:$PYTHONPATH

%post
    # Avoid interactive prompts during package installation
    export DEBIAN_FRONTEND=noninteractive

    # Install system dependencies
    apt-get update && apt-get install -y \
        git \
        wget \
        bash \
        && rm -rf /var/lib/apt/lists/*

    # Install Miniconda
    wget https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O miniconda.sh
    bash miniconda.sh -b -p /opt/conda
    rm miniconda.sh

    # Add conda to path
    export PATH=/opt/conda/bin:$PATH

    # Create and activate conda environment
    . /opt/conda/etc/profile.d/conda.sh
    conda create -n syncmvd python=3.8 -y
    conda activate syncmvd

    # Install PyTorch with CUDA 11.7
    pip install torch==2.0.0+cu117 torchvision==0.15.0+cu117 --extra-index-url https://download.pytorch.org/whl/cu117

    # Install specific versions that work together
    pip install huggingface-hub==0.13.4
    pip install diffusers==0.14.0
    pip install transformers==4.27.4
    pip install accelerate==0.18.0

    # Install fvcore dependencies
    conda install -c fvcore -c iopath -c conda-forge fvcore -y

    # Clone SyncMVD repository
    cd /opt
    git clone https://github.com/LIU-Yuxin/SyncMVD.git
    cd SyncMVD

    # Install remaining requirements (excluding already installed packages)
    pip install accelerate einops imageio imageio-ffmpeg matplotlib numpy omegaconf pillow pytorch3d rich tqdm xatlas

    # Install PyTorch3D
    pip install --no-index --no-cache-dir pytorch3d -f https://dl.fbaipublicfiles.com/pytorch3d/packaging/wheels/py38_cu117_pyt200/download.html

    # Create activation script with proper shell specification
    cat >> /opt/conda/activate_env.sh << 'EOF'
#!/bin/bash
source /opt/conda/etc/profile.d/conda.sh
conda activate syncmvd
export PYTHONPATH=/opt/conda/envs/syncmvd/lib/python3.8/site-packages:$PYTHONPATH
EOF
    chmod +x /opt/conda/activate_env.sh

    # Clean up
    conda clean -afy
    pip cache purge

%runscript
    #!/bin/bash
    source /opt/conda/activate_env.sh
    cd /opt/SyncMVD
    exec /opt/conda/envs/syncmvd/bin/python run_experiment.py "$@"

%labels
    Author maintainer@example.com
    Version v1.0

%help
    This container provides an environment for running SyncMVD.
    It includes CUDA 11.7, Python 3.8, PyTorch3D, and all required dependencies.

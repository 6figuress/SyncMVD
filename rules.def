Bootstrap: docker
From: nvidia/cuda:11.7.1-cudnn8-devel-ubuntu20.04

%environment
    export PATH=/opt/conda/bin:$PATH
    export CUDA_HOME=/usr/local/cuda
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/local/cuda/extras/CUPTI/lib64:/usr/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH
    export CONDA_PREFIX=/opt/conda
    export CONDA_DEFAULT_ENV=syncmvd
    export PYTHONPATH=/opt/conda/envs/syncmvd/lib/python3.8/site-packages:$PYTHONPATH

%files
    ./ /opt/SyncMVD/

%post
    # Avoid interactive prompts during package installation
    export DEBIAN_FRONTEND=noninteractive

    # Install system dependencies
    apt-get update && apt-get install -y \
    git \
    wget \
    bash \
    && rm -rf /var/lib/apt/lists/*

    # Set CUDA environment variables for the build
    export CUDA_HOME=/usr/local/cuda
    export PATH=/usr/local/cuda/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/local/cuda/extras/CUPTI/lib64:/usr/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH

    # Install Miniconda
    wget https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O miniconda.sh
    bash miniconda.sh -b -p /opt/conda
    rm miniconda.sh

    # Add conda to path
    export PATH=/opt/conda/bin:$PATH

    # Create and activate conda environment
    . /opt/conda/etc/profile.d/conda.sh
    conda create -n syncmvd python=3.8 -y
    conda activate syncmvd

    # Install CuPy with conda
    conda install -c conda-forge cupy cuda-version=11.7 -y

    # Install fvcore dependencies
    conda install -c fvcore -c iopath -c conda-forge fvcore -y

    # Remove cupy from requirements (since we installed it with conda)
    cd /opt/SyncMVD
    sed -i '/cupy/d' requirements.txt

    # Set CUDA compute capability
    export TORCH_CUDA_ARCH_LIST="6.0;6.1;7.0;7.5;8.0;8.6"

    # Install remaining requirements
    pip install -r requirements.txt --extra-index-url https://download.pytorch.org/whl/cu117

    # Install additional required packages
    pip install diffusers==0.19.3 transformers==4.36.0 accelerate

    # Patch diffusers code to remove cached_download
    DIFFUSERS_PATH="/opt/conda/envs/syncmvd/lib/python3.8/site-packages/diffusers/utils/dynamic_modules_utils.py"
    sed -i 's/from huggingface_hub import HfFolder, cached_download, hf_hub_download, model_info/from huggingface_hub import HfFolder, hf_hub_download, model_info/g' "$DIFFUSERS_PATH"

    # Install PyTorch3D
    pip install --no-index --no-cache-dir pytorch3d -f https://dl.fbaipublicfiles.com/pytorch3d/packaging/wheels/py38_cu117_pyt200/download.html

    # Create activation script
    cat >> /opt/conda/activate_env.sh << 'EOF'
    #!/bin/bash
    . /opt/conda/etc/profile.d/conda.sh
    conda activate syncmvd
    EOF
    chmod +x /opt/conda/activate_env.sh

    # Clean up
    conda clean -afy
    pip cache purge

%runscript
    #!/bin/bash
    . /opt/conda/etc/profile.d/conda.sh
    conda activate syncmvd

    # Runtime CUDA verification
    echo "=== Checking CUDA Setup ==="
    python -c "
import torch
import cupy as cp
print('PyTorch CUDA available:', torch.cuda.is_available())
print('PyTorch CUDA version:', torch.version.cuda)
print('CuPy CUDA available:', cp.cuda.is_available())
print('CuPy CUDA runtime version:', cp.cuda.runtime.runtimeGetVersion())
try:
    device_count = cp.cuda.runtime.getDeviceCount()
    print('Number of CUDA devices:', device_count)
except Exception as e:
    print('Error checking CUDA devices:', e)
"
    echo "===================="

    # Clear CuPy cache
    python -c "import cupy as cp; cp.clear_memo(); cp.get_default_memory_pool().free_all_blocks()"

    cd /opt/SyncMVD
    exec /opt/conda/envs/syncmvd/bin/python run_experiment.py "$@"

%labels
    Author Osmani Dion
    Version v1.0

%help
    This container provides an environment for running SyncMVD.
    It includes CUDA 11.7, Python 3.8, PyTorch3D, and all required dependencies.

    To run the container:
    $ apptainer run --nv container.sif image-to-3d
